# Claude Code 탐색 제외 목록
# 빌드 산출물, 캐시, 불필요한 바이너리를 제외하여 토큰 낭비 방지

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 의존성
node_modules/
vendor/
bower_components/

# 빌드 산출물
dist/
build/
out/
.next/
.nuxt/
.cache/

# 패키지 lock 파일 (읽어도 의미 없음)
package-lock.json
yarn.lock
pnpm-lock.yaml

# 환경 설정 (보안)
.env
.env.*
*.pem
*.key

# 로그
*.log
logs/

# IDE
.vscode/
.idea/
*.suo
*.user

# Git 내부
.git/
